[Unit]
Description=ship-rs authentication service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ship-rs
Group=ship-rs
EnvironmentFile=/etc/ship-rs/ship-rs.env
ExecStart=/usr/local/bin/ship-rs serve --config /etc/ship-rs/sites.toml
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
# AF_UNIX lets glibc NSS talk to systemd-resolved on Arch. MemoryDenyWriteExecute is omitted so the unit stays conservative for the process startup path.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ReadOnlyPaths=/etc/ship-rs

[Install]
WantedBy=multi-user.target
