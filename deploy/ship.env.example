# /etc/ship-rs/ship-rs.env
# chmod 0600, owner root. systemd reads this as root; the ship-rs user does not.
# Generate a cookie key with: openssl rand -base64 32

SHIP_GOOGLE_CLIENT_ID=
SHIP_GOOGLE_CLIENT_SECRET=
SHIP_GITHUB_CLIENT_ID=
SHIP_GITHUB_CLIENT_SECRET=
SHIP_COOKIE_KEY=
SHIP_SESSION_TTL=12h
