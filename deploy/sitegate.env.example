# /etc/sitegate/sitegate.env
# chmod 0600, owner root. systemd reads this as root; the sitegate user does not.
# Generate a cookie key with: openssl rand -base64 32

SITEGATE_GOOGLE_CLIENT_ID=
SITEGATE_GOOGLE_CLIENT_SECRET=
SITEGATE_GITHUB_CLIENT_ID=
SITEGATE_GITHUB_CLIENT_SECRET=
SITEGATE_COOKIE_KEY=
SITEGATE_SESSION_TTL=12h
