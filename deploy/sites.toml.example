# Installation manifest. Copy to /etc/ship-rs/sites.toml and edit.
# This file is not the repo's example sites. Real site files live on the
# VPS, typically under /srv/ship-rs, and are not committed here.
# Do not put OAuth secrets in this file.

base_domain = "example.com"
acme_email = "admin@example.com"
tls = "auto"
auth_upstream = "127.0.0.1:8091"
caddyfile = "/etc/caddy/Caddyfile"

admins = ["admin@example.com"]

[hub]
title = "Sites"
deploy = "/srv/ship-rs/hub"

[[sites]]
slug = "hello"
title = "Public hello"
# source = "/srv/ship-rs/src/hello"
deploy = "/srv/ship-rs/sites/hello"
subdomain = "hello"
public = true

[[sites]]
slug = "notes"
title = "Protected hello"
# source = "/srv/ship-rs/src/notes"
deploy = "/srv/ship-rs/sites/notes"
subdomain = "notes"
public = false
allow = ["guest@example.com"]

# [[sites]]
# slug = "app"
# title = "App"
# source = "/srv/ship-rs/src/app"
# build = "npm ci && npm run build"
# deploy = "/srv/ship-rs/sites/app"
